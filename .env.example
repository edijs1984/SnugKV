# Required by docker-compose.yml
SNUGKV_WEBHOOKS_KEY=change-me-at-least-16-characters
SNUGKV_WEBHOOKS_API_TOKEN=change-me

# Optional
# SNUGKV_FSYNC=everysec          # always | everysec | no
# SNUGKV_MAX_MEMORY=0            # bytes, 0 = unlimited
# SNUGKV_WEBHOOKS_PUBLIC_URL=https://hooks.example.com
