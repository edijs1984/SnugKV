{
  "name": "@snugkv/client",
  "version": "0.3.0",
  "description": "TypeScript client for SnugKV with automatic same-tick RESP pipelining",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "bench:autopipeline": "npm run build && node benchmarks/autopipeline.mjs",
    "bench:latency": "npm run build && node benchmarks/latency.mjs",
    "bench:clients": "npm run build && node benchmarks/clients.mjs",
    "bench:client-matrix": "npm run build && node benchmarks/client-matrix.mjs",
    "bench:stack-matrix": "npm run build && node benchmarks/stack-matrix.mjs",
    "prepublishOnly": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "ioredis": "^6.0.0",
    "redis": "^6.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edijs1984/SnugKV.git",
    "directory": "clients/typescript"
  },
  "homepage": "https://github.com/edijs1984/SnugKV/tree/main/clients/typescript",
  "keywords": [
    "snugkv",
    "redis",
    "client",
    "resp",
    "json"
  ]
}
